quit-after-last-window-closed = true
#####################
#      Appearance   #
#####################
window-decoration = false
adjust-cell-height = 20%
window-padding-x = 10
window-padding-y = 5
unfocused-split-opacity = 1
mouse-hide-while-typing = true
#####################
#      Theme        #
#####################
# Mies Light for Ghostty — colors from https://github.com/jaredgorski/Mies.vim

# Editor (light Normal / Cursor / Visual)
background = #ffffff
foreground = #080808
cursor-color = #1c1c1c
cursor-text = #ffffff
selection-background = #B0B0B0
selection-foreground = #080808

# Black — chicagoBlack1 / chicagoGray3 (bright black ≈ comments)
palette = 0=#080808
palette = 8=#767676

# Red — chicagoRed only (no bright variant in Mies)
palette = 1=#D70000
palette = 9=#D70000

# Green — chicagoGreen1 / chicagoGreen2
palette = 2=#008700
palette = 10=#00af5f

# Yellow — chicagoGold1 / chicagoGold2
palette = 3=#8E700B
palette = 11=#D7AF00

# Blue — chicagoBlue only
palette = 4=#5F8787
palette = 12=#5F8787

# Magenta — no magenta in Mies; chicagoBrown / chicagoGray4
palette = 5=#5F5F00
palette = 13=#949494

# Cyan — no distinct cyan; same teal as blue
palette = 6=#5F8787
palette = 14=#5F8787

# White — chicagoGray6 / chicagoWhite1 (not #fff; invisible on light bg)
palette = 7=#C6C6C6
palette = 15=#D0D0D0
